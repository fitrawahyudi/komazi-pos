# =============================================================================
# KOMAZI POS & WORKSPACE - GIT IGNORE
# =============================================================================

# 1. Dependency Directories
node_modules/
*/node_modules/
**/node_modules/

# 2. Build Outputs
dist/
dist-ssr/
frontend/dist/
build/
**/build/

# 3. Environment Variables & Secrets (CRITICAL - DO NOT COMMIT SENSITIVE DATA)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# 4. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Android & Mobile Builds
.gradle/
**/android/.gradle/
**/android/build/
**/android/app/build/
**/android/.idea/
*.keystore
*.jks
google-services.json

# 6. IDEs & Editor Files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Desktop.ini

# 7. Temporary & Scratch Files
.gemini/
scratch/
.tempmediaStorage/
*.tmp
*.bak
backend/storage/ai_memories/*.md
!backend/storage/ai_memories/.gitkeep

# 8. Dynamic User Uploads & Media
backend/public/uploads/*
!backend/public/uploads/.gitkeep
backend/public/uploads/attendance/*
!backend/public/uploads/attendance/.gitkeep

# 9. Archives, Zips & Temporary Exports
*.zip
*.tar.gz
*.rar
*.7z
*.xlsx
*.xls
*.csv
!templates/*.xlsx
!frontend/public/templates/*.xlsx

# 10. Local AI Assistant Tooling & Customizations
.agents/
skills-lock.json



