# =============================================================================
# KOMAZI POS & WORKSPACE - ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env lalu sesuaikan dengan konfigurasi server/lokal Anda.
# Seluruh API Key dan kredensial eksternal dikelola eksklusif melalui file ini.
# =============================================================================

# 1. Konfigurasi Database MySQL
DATABASE_URL="mysql://root:@localhost:3306/komazi_pos"

# 2. Server & Jaringan
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
TZ=Asia/Jakarta

# 3. Kunci Keamanan JWT Token
JWT_SECRET=komazi_pos_jwt_super_secret_key_2026_coffeeworkspace
JWT_REFRESH_SECRET=komazi_pos_jwt_refresh_super_secret_key_2026

# 4. Cloudinary (Penyimpanan Media & Foto Menu)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 5. Komazi AI Sales Analytics Engine (Multi-Tier Failover via .env)
# Tier 1 (Utama): Groq Cloud LPU (~300ms ultra-fast inference)
# Dapatkan gratis di https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Tier 2 (Fallback 1): Google Gemini Cloud AI (Generative Multimodal LLM)
# Dapatkan gratis di https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Tier 3 (Fallback 2): Ezkielyna AI Cloud (Multi-model Gateway, Pembayaran QRIS)
# Dapatkan di https://api.ezkielyna.store (Grup Auto / Standard)
EZKIELYNA_API_KEY=sk-your_ezkielyna_api_key_here
EZKIELYNA_MODEL=deepseek-v4.1-flash
EZKIELYNA_BASE_URL=https://api.ezkielyna.store/v1

# Tier 4 (Fallback 3): OpenRouter AI Cloud
# Dapatkan di https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Provider AI Prioritas Utama (Pilihan: groq | gemini | ezkielyna | openrouter)
AI_PRIMARY_PROVIDER=groq

# Tier 5: Komazi Deterministic Engine (Offline Local Otomatis - Tidak perlu API Key)

# Provider Utama: groq
AI_PRIMARY_PROVIDER=groq

# 6. Firebase Cloud Messaging (FCM) & Android Push Notifications
# Dapatkan dari Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Opsi A: Filepath lokal ke berkas service account JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
# Opsi B: String JSON atau base64 string (Direkomendasikan untuk Railway / Cloud secrets)
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project-id",...}'

# =============================================================================
# 7. OpenClaw AI Gateway (Telegram Bot Assistant Integration)
# Service terpisah di Railway. Jangan berikan token Telegram utama kepada OpenClaw!
# =============================================================================
AI_ENABLED=false
OPENCLAW_BASE_URL=http://localhost:18789
OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token_here
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_INPUT_CHARS=500
AI_MAX_OUTPUT_CHARS=1500
AI_MAX_CONCURRENT_REQUESTS=1
AI_USER_DAILY_LIMIT=30
AI_ALLOWED_ROLES=OWNER,MANAGER

# =============================================================================
# 8. Database Backup & Disaster Recovery (Layer A, B & C)
# =============================================================================
BACKUP_ENABLED=true
# Jadwal otomatis: 02:00 WIB (Asia/Jakarta) = 19:00 UTC pada hari sebelumnya
BACKUP_SCHEDULE="0 19 * * *"
BACKUP_TIMEZONE="Asia/Jakarta"
BACKUP_STORAGE_PROVIDER=LOCAL
BACKUP_STORAGE_PATH="./scratch/backups"
# Kunci enkripsi AES-256-GCM (Wajib 32 karakter acak untuk mode production)
BACKUP_ENCRYPTION_KEY="your_super_secret_backup_aes256_key_32chars"
# Kebijakan retensi otomatis (dalam hari)
BACKUP_RETENTION_DAILY=14
BACKUP_RETENTION_WEEKLY=56
BACKUP_RETENTION_MONTHLY=180
BACKUP_TIMEOUT_MS=60000
BACKUP_MAX_RETRIES=3

