generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  BARISTA
}

enum StationType {
  KITCHEN
  BAR
  OTHER
}

enum OrderType {
  DINE_IN
  TAKE_AWAY
}

enum OrderStatus {
  OPEN
  PENDING_PAYMENT
  PAID
  PREPARING
  IN_PROGRESS
  PARTIALLY_READY
  READY
  SERVED
  COMPLETED
  VOIDED
  REFUNDED
}

enum ApprovalType {
  VOID_ORDER
  DISCOUNT
  REFUND
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}


enum OrderItemStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum KitchenStatus {
  PENDING
  IN_PROGRESS
  READY
  SERVED
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
}

enum SessionStatus {
  ACTIVE
  COMPLETED
}

enum StockMovementType {
  PURCHASE
  ADJUSTMENT
  WASTE
  SALE
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  username  String   @unique
  password  String
  role      Role     @default(CASHIER)
  avatarUrl String?  @db.LongText
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  telegramId       String?   @unique
  telegramUsername String?
  telegramLinkedAt DateTime?

  orders             Order[]
  shifts             Shift[]
  auditLogs          AuditLog[]
  linkCodes          TelegramLinkCode[]
  approvalsRequested ApprovalRequest[]  @relation("Requester")
  approvalsDecided   ApprovalRequest[]  @relation("Decider")
}

model Station {
  id        Int         @id @default(autoincrement())
  name      String
  code      String      @unique
  type      StationType
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  products   Product[]
  orderItems OrderItem[]
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  stationId   Int?
  sku         String?  @unique
  name        String
  price       Decimal  @db.Decimal(12, 2)
  imageUrl    String?  @db.Text
  description String?  @db.Text
  modifiers   Json?
  isActive    Boolean  @default(true)
  isSoldOut   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category    Category            @relation(fields: [categoryId], references: [id])
  station     Station?            @relation(fields: [stationId], references: [id])
  variants    ProductVariant[]
  orderItems  OrderItem[]
  recipeItems ProductRecipeItem[]

  @@index([categoryId])
  @@index([stationId])
}

model ProductVariant {
  id         Int     @id @default(autoincrement())
  productId  Int
  name       String
  extraPrice Decimal @default(0) @db.Decimal(12, 2)

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipeItems ProductRecipeItem[]
}

model Order {
  id           Int           @id @default(autoincrement())
  invoiceNo    String        @unique
  cashierId    Int
  shiftId      Int?
  type         OrderType     @default(DINE_IN)
  tableNo      String?
  customerName String?
  status       OrderStatus   @default(OPEN)
  kitchenStatus KitchenStatus @default(PENDING)
  barStatus     KitchenStatus @default(PENDING)
  subtotal     Decimal       @db.Decimal(12, 2)
  discount     Decimal       @default(0) @db.Decimal(12, 2)
  tax          Decimal       @default(0) @db.Decimal(12, 2)
  serviceFee   Decimal       @default(0) @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  voidReason   String?
  createdAt    DateTime      @default(now())
  paidAt       DateTime?

  cashier    User              @relation(fields: [cashierId], references: [id])
  shift      Shift?            @relation(fields: [shiftId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  workspace  WorkspaceSession[]

  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  productId   Int
  stationId   Int?
  productName String
  variantName String?
  qty         Int
  unitPrice   Decimal         @db.Decimal(12, 2)
  unitCost    Decimal         @default(0) @db.Decimal(12, 2)
  discount    Decimal         @default(0) @db.Decimal(12, 2)
  note        String?
  lineTotal   Decimal         @db.Decimal(12, 2)
  lineCost    Decimal         @default(0) @db.Decimal(12, 2)
  status      OrderItemStatus @default(PENDING)
  acceptedAt  DateTime?
  preparingAt DateTime?
  readyAt     DateTime?
  servedAt    DateTime?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id])
  station Station? @relation(fields: [stationId], references: [id])

  @@index([orderId])
  @@index([stationId, status])
}

model Payment {
  id        Int           @id @default(autoincrement())
  orderId   Int
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Shift {
  id           Int       @id @default(autoincrement())
  cashierId    Int
  openingCash  Decimal   @db.Decimal(12, 2)
  closingCash  Decimal?  @db.Decimal(12, 2)
  expectedCash Decimal?  @db.Decimal(12, 2)
  openedAt     DateTime  @default(now())
  closedAt     DateTime?

  cashier User    @relation(fields: [cashierId], references: [id])
  orders  Order[]
}

model WorkspaceArea {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  capacity Int     @default(1)
  isActive Boolean @default(true)

  sessions WorkspaceSession[]
}

model WorkspacePackage {
  id            Int     @id @default(autoincrement())
  name          String
  durationMin   Int
  price         Decimal @db.Decimal(12, 2)
  overtimePerHr Decimal @default(0) @db.Decimal(12, 2)
  isActive      Boolean @default(true)

  sessions WorkspaceSession[]
}

model WorkspaceSession {
  id           Int           @id @default(autoincrement())
  areaId       Int
  packageId    Int
  orderId      Int?
  customerName String
  phone        String?
  checkInAt    DateTime      @default(now())
  checkOutAt   DateTime?
  status       SessionStatus @default(ACTIVE)
  charge       Decimal?      @db.Decimal(12, 2)

  area    WorkspaceArea    @relation(fields: [areaId], references: [id])
  package WorkspacePackage @relation(fields: [packageId], references: [id])
  order   Order?           @relation(fields: [orderId], references: [id])
}

model Ingredient {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  unit        String
  stock       Decimal  @default(0) @db.Decimal(12, 2)
  minStock    Decimal  @default(0) @db.Decimal(12, 2)
  costPerUnit Decimal  @default(0) @db.Decimal(12, 4)

  movements   StockMovement[]
  recipeItems ProductRecipeItem[]
}

model StockMovement {
  id           Int               @id @default(autoincrement())
  ingredientId Int
  type         StockMovementType
  qty          Decimal           @db.Decimal(12, 2)
  unitCost     Decimal?          @db.Decimal(12, 4)
  totalCost    Decimal?          @db.Decimal(12, 2)
  note         String?
  createdAt    DateTime          @default(now())

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
}

model ProductRecipeItem {
  id           Int             @id @default(autoincrement())
  productId    Int
  variantId    Int?
  ingredientId Int
  quantity     Decimal         @db.Decimal(12, 4)

  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([variantId])
  @@index([ingredientId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Setting {
  key   String @id
  value String @db.Text
}

model TelegramLinkCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  code      String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApprovalRequest {
  id          Int            @id @default(autoincrement())
  type        ApprovalType
  orderId     Int
  requesterId Int
  deciderId   Int?
  status      ApprovalStatus @default(PENDING)
  reason      String
  payload     Json?
  createdAt   DateTime       @default(now())
  decidedAt   DateTime?

  requester User  @relation("Requester", fields: [requesterId], references: [id])
  decider   User? @relation("Decider", fields: [deciderId], references: [id])

  @@index([status])
  @@index([orderId])
  @@index([requesterId])
  @@index([deciderId])
}

